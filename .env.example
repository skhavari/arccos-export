# First run: sign in with your Arccos account. The exporter prints an access key to use instead.
ARCCOS_USERNAME=you@example.com
ARCCOS_PASSWORD=your_password_here

# Preferred after the first run: paste the printed access key and remove the password.
# ARCCOS_USER_ID=your_user_id_here
# ARCCOS_ACCESS_KEY=your_access_key_here
# ARCCOS_SECRET=your_secret_here