{
    // Type-check only: Node runs the .ts files directly by stripping the types
    "compilerOptions": {
        "noEmit": true,
        "target": "esnext",
        "lib": ["esnext"],
        "module": "nodenext",
        "types": ["node"],
        "strict": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    }
}
